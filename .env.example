# Compass configuration.
#
# You almost certainly only need CONSOLE_MASTER_KEY, which ./scripts/setup.sh
# generates for you. Everything about the GitHub App is registered from the
# Console's own /setup screen, and the orgs and repositories you want to watch
# are chosen in the UI (Onboarding → Connect an organisation) — never in this file.

# ============================================================================
# REQUIRED
# ============================================================================

# 32 random bytes, base64. Encrypts stored GitHub tokens, the App's own private
# key, and cached repository content at rest. Generated by ./scripts/setup.sh.
#   openssl rand -base64 32
# Back it up: losing it invalidates every stored credential.
CONSOLE_MASTER_KEY=

# ============================================================================
# COMMON
# ============================================================================

# The origin the browser uses. OAuth callbacks and the App's webhook URL are
# derived from it, so it must match how you actually reach the Console.
#   docker (scripts/start.sh) -> http://localhost:8080
#   dev    (scripts/dev.sh)   -> http://localhost:5173
#   public tunnel             -> https://your-name.trycloudflare.com
PUBLIC_ORIGIN=http://localhost:8080

# Enables the "Ask the Factory" Q&A panel. Leave blank to run without it.
ANTHROPIC_API_KEY=

# Postgres password used by docker-compose.
DB_PASSWORD=console

# ============================================================================
# OPTIONAL — sensible defaults, change only if you need to
# ============================================================================

# DATABASE_URL=postgres://console:console@localhost:5432/console
# REDIS_URL=redis://localhost:6379
# API_PORT=8787

# Host port docker-compose publishes nginx on. Local default is 8080.
# Production goes through Traefik (TRAEFIK_ENABLE / CONSOLE_HOST); do not bind :80.
# WEB_HOST_PORT=8080

# Insight service model routing and per-org monthly token budget.
# INSIGHT_FAST_MODEL=claude-haiku-4-5-20251001
# INSIGHT_DEEP_MODEL=claude-sonnet-5
# INSIGHT_ORG_BUDGET_TOKENS=5000000

# Minutes since the last successful sync before the staleness banner appears.
# STALENESS_THRESHOLD_MINUTES=15

# Software Factory orchestrator (when Settings → engine is software-factory).
# The Console App's GitHub webhooks come here via PUBLIC_ORIGIN; they do not
# reach the orchestrator. Profile Re-run therefore POSTs /dispatch instead.
# From docker-compose the default is http://host.docker.internal:8080.
# ORCHESTRATOR_URL=http://host.docker.internal:8080
# Must match the orchestrator's DISPATCH_TOKEN (orchestrator .env default:
# dev-dispatch-token).
# ORCHESTRATOR_DISPATCH_TOKEN=dev-dispatch-token

# Dev only: "1" enables /auth/dev-login so you can browse the UI without a
# GitHub App. Never enable this in production.
# DEV_FAKE_LOGIN=0

# Local only: set to true and restart the API to show "Reset GitHub App
# credentials" on the home page, then paste a new App. Unset it afterwards.
# APP_RESET=true

# ============================================================================
# GITHUB APP — SaaS platform credential
# ============================================================================
# One App signs every user in and is installed on every org that wants the
# factory. Required in production (GitHub Environment secrets). The App must
# be public and its Callback URL must be {PUBLIC_ORIGIN}/auth/github/callback.
# Locally you can leave these blank and use DEV_FAKE_LOGIN=1, or paste them
# here. A factory admin can also set or rotate them from Settings after
# signing in. The private key may be PKCS#1 or PKCS#8; newlines as \n are fine.
#
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
#
# GitHub Enterprise Server:
# GITHUB_API_URL=https://github.example.com/api/v3
# GITHUB_WEB_URL=https://github.example.com

# Hosted deploy (VPS, same path as Sales OS): see infra/cloud.env.example.
# Do not put DEPLOY_KEY or CONSOLE_MASTER_KEY in this file for production.
