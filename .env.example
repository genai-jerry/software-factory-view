# ---- Required for real operation (see README "GitHub App setup") ----
# The GitHub App you register for your Console instance:
GITHUB_APP_ID=
# PKCS#8 PEM (convert the downloaded key: openssl pkcs8 -topk8 -nocrypt -in app.pem -out app-pkcs8.pem)
# \n-escaped single line is accepted.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# The App's OAuth credentials (from the same App settings page):
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# 32 random bytes, base64 — encrypts OAuth tokens and cached repo content at rest:
#   openssl rand -base64 32
CONSOLE_MASTER_KEY=

# Public origin the browser uses (OAuth callback goes here):
PUBLIC_ORIGIN=http://localhost:8080

# ---- Optional ----
# Enables the Ask-the-Factory Q&A panel:
ANTHROPIC_API_KEY=
INSIGHT_FAST_MODEL=claude-haiku-4-5-20251001
INSIGHT_DEEP_MODEL=claude-sonnet-5
INSIGHT_ORG_BUDGET_TOKENS=5000000

# Postgres password for docker-compose:
DB_PASSWORD=console

# Staleness banner threshold (minutes since last successful sync):
STALENESS_THRESHOLD_MINUTES=15

# Dev only: "1" allows /auth/dev-login without GitHub (never in production):
DEV_FAKE_LOGIN=0
