{
  "name": "software-factory-view",
  "private": true,
  "version": "0.1.0",
  "description": "Compass — a lens and control panel over the Claude Software Factory",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genai-jerry/software-factory-view.git"
  },
  "homepage": "https://github.com/genai-jerry/software-factory-view#readme",
  "bugs": {
    "url": "https://github.com/genai-jerry/software-factory-view/issues"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev:api": "pnpm --filter @console/api dev",
    "dev:worker": "pnpm --filter @console/worker dev",
    "dev:web": "pnpm --filter @console/web dev",
    "db:migrate": "pnpm --filter @console/db migrate"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
