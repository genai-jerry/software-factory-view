# Production .env for Factory Console on the VPS ($HOME/factory-console/.env).
#
# GitHub Actions writes these keys on each deploy. You do not need to edit
# this file by hand unless you are bootstrapping without CI.
# See README "Cloud deploy".

# ---------------------------------------------------------------------------
# GitHub Environment "production"
# ---------------------------------------------------------------------------
# DEPLOY_HOST / DEPLOY_USER / DEPLOY_KEY   secrets   SSH trio (copy from lighthouse-sales)
# PUBLIC_ORIGIN                            variable  https://sf.genaipeople.com
# CONSOLE_MASTER_KEY                       secret    openssl rand -base64 32
# DB_PASSWORD                              secret    postgres password on this VPS
# GH_APP_ID                                secret    SaaS GitHub App numeric id
# GH_APP_PRIVATE_KEY                       secret    PEM; newlines as \n
# GH_APP_WEBHOOK_SECRET                    secret
# GH_OAUTH_CLIENT_ID                       secret
# GH_OAUTH_CLIENT_SECRET                   secret
# GitHub forbids secret names starting with GITHUB_. The workflow maps GH_*
# onto GITHUB_APP_* / GITHUB_OAUTH_* in this .env.
# ANTHROPIC_API_KEY                        secret    optional, Ask the Factory
# ORCHESTRATOR_DISPATCH_TOKEN              secret    optional, match orchestrator DISPATCH_TOKEN
# ORCHESTRATOR_URL                         variable  optional, default http://factory-orchestrator:8080

# ---------------------------------------------------------------------------
# Written to ~/factory-console/.env (api + worker via env_file).
# Postgres and Redis run in the same compose project — do not set DATABASE_URL
# or REDIS_URL; compose builds those from DB_PASSWORD.
# ---------------------------------------------------------------------------

# REQUIRED. 32 random bytes, base64. Encrypts OAuth tokens, the GitHub App
# private key, and cached repo content at rest. Losing it invalidates every
# stored credential — back it up.
#   openssl rand -base64 32
CONSOLE_MASTER_KEY=

# REQUIRED. Public origin the browser uses. OAuth callbacks and the GitHub
# App webhook URL are derived from it.
#   https://sf.genaipeople.com
PUBLIC_ORIGIN=

# REQUIRED. Postgres password for the in-compose database.
DB_PASSWORD=

# Set by the workflow from PUBLIC_ORIGIN (hostname only). Traefik Host() rule.
# CONSOLE_HOST=sf.genaipeople.com

# OPTIONAL. Enables Ask the Factory.
# ANTHROPIC_API_KEY=

# REQUIRED (the SaaS GitHub App). One App signs every customer in and is
# installed on every org that wants the factory. The App must be public and
# its Callback URL must be {PUBLIC_ORIGIN}/auth/github/callback — a private
# App 404s on Sign in with GitHub for anyone who is not the owner.
# A factory admin can also set or rotate these from Settings after signing in.
# Private key may be PKCS#1 or PKCS#8; encode newlines as \n.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# OPTIONAL. GitHub Enterprise Server.
# GITHUB_API_URL=https://github.example.com/api/v3
# GITHUB_WEB_URL=https://github.example.com

# NEVER set in production:
# DEV_FAKE_LOGIN=1

# OPTIONAL. LangGraph orchestrator on this VPS (~/factory-orchestrator).
# GitHub webhooks still hit this Console; the worker POSTs /events.
# ORCHESTRATOR_URL=http://factory-orchestrator:8080
# ORCHESTRATOR_DISPATCH_TOKEN=
