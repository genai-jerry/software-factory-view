# Production environment for Factory Console on Hostinger VPS Docker Manager.
#
# VPS panel: https://hpanel.hostinger.com/vps/1659755/docker-manager
#
# GitHub Actions does not read this file. Set the values as GitHub Environment
# "production" secrets/variables, or as project environment variables in Docker
# Manager if you compose from URL by hand. See README "Cloud deploy".

# ---------------------------------------------------------------------------
# GitHub Environment "production"
# ---------------------------------------------------------------------------
# HOSTINGER_API_KEY      secret     required   hPanel → profile → API
# HOSTINGER_VM_ID        variable   optional   default 1659755
# PUBLIC_ORIGIN          variable   required   https://your-domain
# CONSOLE_MASTER_KEY     secret     required   openssl rand -base64 32
# DB_PASSWORD            secret     required   postgres password on this VPS
# GITHUB_APP_ID          secret     required   SaaS GitHub App numeric id
# GITHUB_APP_PRIVATE_KEY secret     required   PEM; newlines as \n
# GITHUB_APP_WEBHOOK_SECRET secret  required
# GITHUB_OAUTH_CLIENT_ID secret     required
# GITHUB_OAUTH_CLIENT_SECRET secret required
# ANTHROPIC_API_KEY      secret     optional   Ask the Factory

# ---------------------------------------------------------------------------
# Injected into docker-compose on the VPS (api + worker). Web is static files.
# Postgres and Redis run in the same compose project — do not set DATABASE_URL
# or REDIS_URL; compose builds those from DB_PASSWORD.
# ---------------------------------------------------------------------------

# REQUIRED. 32 random bytes, base64. Encrypts OAuth tokens, the GitHub App
# private key, and cached repo content at rest. Losing it invalidates every
# stored credential — back it up.
#   openssl rand -base64 32
CONSOLE_MASTER_KEY=

# REQUIRED. Public origin the browser uses. OAuth callbacks and the GitHub
# App webhook URL are derived from it.
#   https://console.example.com
#   https://srv1659755.hstgr.cloud
#   http://YOUR.VPS.IP:80          (sign-in works; GitHub webhooks prefer HTTPS)
PUBLIC_ORIGIN=

# REQUIRED on Hostinger. Postgres password for the in-compose database.
# Local docker defaults to "console" if unset.
DB_PASSWORD=

# Host port nginx is published on. GitHub deploy sets 80. Local docker uses 8080.
# WEB_HOST_PORT=80

# OPTIONAL. Enables Ask the Factory.
# ANTHROPIC_API_KEY=

# REQUIRED on Hostinger (the SaaS GitHub App). One App signs every customer in
# and is installed on every org that wants the factory. A factory admin can
# also set or rotate these from Settings after signing in. Private key may be
# PKCS#1 or PKCS#8; encode newlines as \n.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# OPTIONAL. GitHub Enterprise Server.
# GITHUB_API_URL=https://github.example.com/api/v3
# GITHUB_WEB_URL=https://github.example.com

# NEVER set in production:
# DEV_FAKE_LOGIN=1
