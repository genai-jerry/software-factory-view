+    def remember_console_url(self, url: str) -> None:
+        """Hint from a Console dispatch. ``CONSOLE_URL`` in the env still wins."""
+        hint = (url or "").rstrip("/")
+        if hint and not (self.cfg.console_url or "").strip():
+            self.cfg.console_url = hint
