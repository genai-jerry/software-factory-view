+    def _mint_via_app(self, owner: str, repo: str) -> str:
         key = f"{owner}/{repo}"
-        cached = self._tokens.get(key)
-        if cached and cached[1] > time.time() + 120:
-            return cached[0]
         headers = {"Authorization": f"Bearer {self.app_jwt()}",
                    "Accept": "application/vnd.github+json"}
-        r = self.http.get(f"/repos/{owner}/{repo}/installation", headers=headers)
-        r.raise_for_status()
-        inst_id = r.json()["id"]
+        inst_id = self._installations.get(key)
+        if inst_id is None:
+            r = self.http.get(f"/repos/{owner}/{repo}/installation", headers=headers)
+            r.raise_for_status()
+            inst_id = int(r.json()["id"])
+            self._installations[key] = inst_id
         r = self.http.post(f"/app/installations/{inst_id}/access_tokens", headers=headers)
         r.raise_for_status()
         token = r.json()["token"]
-        # Installation tokens live ~1h; refresh with headroom.
         self._tokens[key] = (token, time.time() + 55 * 60)
         return token
 
+    def _mint_via_console(self, owner: str, repo: str) -> str | None:
+        base = (self.cfg.console_url or "").rstrip("/")
+        inst_id = self._installations.get(f"{owner}/{repo}")
+        dispatch = self.cfg.dispatch_token.reveal()
+        if not base or not inst_id or not dispatch:
+            return None
+        try:
+            r = httpx.post(
+                f"{base}/api/orchestrator/github-token",
+                headers={"authorization": f"Bearer {dispatch}", "content-type": "application/json"},
+                json={"installation_id": inst_id},
+                timeout=10,
+            )
+            r.raise_for_status()
+            data = r.json()
+        except Exception:  # noqa: BLE001 - Console is optional; fall back to dispatch-time token
+            log.warning("Console token refresh failed for %s/%s", owner, repo, exc_info=True)
+            return None
+        token = data.get("token")
+        if not isinstance(token, str) or not token:
+            return None
+        self._tokens[f"{owner}/{repo}"] = (token, time.time() + _ttl_from_expires_at(data.get("expires_at")))
+        log.info("minted GitHub installation token via Console for %s/%s", owner, repo)
+        return token
+
     def repo_client(self, owner: str, repo: str) -> RepoClient:
         return RepoClient(self, owner, repo)
 
 
+def _ttl_from_expires_at(expires_at: object) -> float:
+    if not isinstance(expires_at, str) or not expires_at:
+        return 55 * 60
+    try:
+        ts = datetime.fromisoformat(expires_at.replace("Z", "+00:00")).timestamp()
+        return max(60.0, ts - time.time() - 60)
+    except ValueError:
+        return 55 * 60
+
