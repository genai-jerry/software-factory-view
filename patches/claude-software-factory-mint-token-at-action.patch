     def cache_token(self, owner: str, repo: str, token: str, *, ttl_seconds: float = 50 * 60) -> None:
-        """Use a caller-supplied installation token (Console /dispatch) instead of minting a JWT."""
-        self._tokens[f"{owner}/{repo}"] = (token, time.time() + ttl_seconds)
+        """Keep a Console-supplied token as last-resort fallback.
+
+        It must not become the primary cache: those tokens are captured at
+        /dispatch and expire in ~1h, while a Profiler run can take 45 minutes.
+        Live minting (App JWT or Console refresh) happens at GitHub-call time.
+        """
+        del ttl_seconds
+        self._fallback[f"{owner}/{repo}"] = token
