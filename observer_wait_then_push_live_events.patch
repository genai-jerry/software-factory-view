+def _comment_bodies(raw: str) -> list[str]:
+    try:
+        data = json.loads(raw or "[]")
+    except json.JSONDecodeError:
+        return []
+    if not isinstance(data, list):
+        return []
+    bodies = []
+    for item in data:
+        if isinstance(item, dict) and isinstance(item.get("body"), str):
+            bodies.append(item["body"])
+    return bodies
